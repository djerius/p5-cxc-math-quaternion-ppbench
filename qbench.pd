pp_bless('QBench');
# shared C rotation code (qrot.h) and helpers for the plain-XS functions below;
# pp_addhdr text goes into QBench.xs and every pp-*.c file
pp_addhdr(<<'EOH');
#include "qrot.h"

/* the array behind an array ref */
static inline AV *
qb_av(pTHX_ SV *ref, const char *what)
{
    if (!SvROK(ref) || SvTYPE(SvRV(ref)) != SVt_PVAV)
        croak("%s must be an array reference", what);
    return (AV *)SvRV(ref);
}

/* copy the first n numbers of an array ref */
static inline void
qb_get(pTHX_ SV *ref, double *d, int n, const char *what)
{
    AV *av = qb_av(aTHX_ ref, what);
    int i;
    if (av_count(av) < (Size_t)n)
        croak("%s must have %d elements", what, n);
    for (i = 0; i < n; i++) {
        SV **e = av_fetch(av, i, 0);
        d[i] = e ? SvNV(*e) : 0;
    }
}

/* a new [x, y, z] array ref */
static inline SV *
qb_vec3(pTHX_ const double *r)
{
    AV *av = newAV();
    av_extend(av, 2);
    av_store(av, 0, newSVnv(r[0]));
    av_store(av, 1, newSVnv(r[1]));
    av_store(av, 2, newSVnv(r[2]));
    return newRV_noinc((SV *)av);
}
/* store into element i of av, reusing the existing scalar if there is one */
static inline void
qb_set(pTHX_ AV *av, SSize_t i, double val)
{
    SV **e = av_fetch(av, i, 1);
    if (!e) croak("cannot store element %ld", (long)i);
    sv_setnv(*e, val);
    SvSETMAGIC(*e);
}

/* the [x, y, z] array in element i of av, created if it is not an array ref */
static inline AV *
qb_vec3_slot(pTHX_ AV *av, SSize_t i)
{
    AV *v;
    SV **e = av_fetch(av, i, 1);
    if (!e) croak("cannot store element %ld", (long)i);
    if (SvROK(*e) && SvTYPE(SvRV(*e)) == SVt_PVAV)
        v = (AV *)SvRV(*e);
    else {
        v = newAV();
        sv_setsv(*e, sv_2mortal(newRV_noinc((SV *)v)));
    }
    av_extend(v, 2);    /* room for [x, y, z]; nothing to do if it is already there */
    return v;
}
EOH

# scalar-last quaternion q = (x,y,z,w); v' = q v q*  (Hamilton)
# v' = v + 2w(u x v) + 2 u x (u x v), u = (x,y,z)
pp_def('rotq',
  Pars => 'q(n=4); v(m=3); [o] r(m=3);',
  GenericTypes => ['D'],
  Code => q{
    double x=$q(n=>0), y=$q(n=>1), z=$q(n=>2), w=$q(n=>3);
    double a=$v(m=>0), b=$v(m=>1), c=$v(m=>2);
    double tx = 2*(y*c - z*b), ty = 2*(z*a - x*c), tz = 2*(x*b - y*a);
    $r(m=>0) = a + w*tx + (y*tz - z*ty);
    $r(m=>1) = b + w*ty + (z*tx - x*tz);
    $r(m=>2) = c + w*tz + (x*ty - y*tx);
  });
pp_def('rotm',
  Pars => 'mat(i=3,j=3); v(i); [o] r(j);',
  GenericTypes => ['D'],
  Code => q{
    loop(j) %{ double s=0; loop(i) %{ s += $mat() * $v(); %} $r() = s; %}
  });
# same rotation, vector given as three separate columns (x, y, z each of shape (N))
pp_def('rotq3',
  Pars => 'q(n=4); a(); b(); c(); [o] ra(); [o] rb(); [o] rc();',
  GenericTypes => ['D'],
  Code => q{
    double x=$q(n=>0), y=$q(n=>1), z=$q(n=>2), w=$q(n=>3);
    double a=$a(), b=$b(), c=$c();
    double tx = 2*(y*c - z*b), ty = 2*(z*a - x*c), tz = 2*(x*b - y*a);
    $ra() = a + w*tx + (y*tz - z*ty);
    $rb() = b + w*ty + (z*tx - x*tz);
    $rc() = c + w*tz + (x*ty - y*tx);
  });
# the same rotation through the shared C implementation in qrot.h
pp_def('rotq_shared',
  Pars => 'q(n=4); v(m=3); [o] r(m=3);',
  GenericTypes => ['D'],
  Code => q{
    double qa[4] = { $q(n=>0), $q(n=>1), $q(n=>2), $q(n=>3) };
    double va[3] = { $v(m=>0), $v(m=>1), $v(m=>2) };
    double ra[3];
    qrot_vec(qa, va, ra);
    $r(m=>0) = ra[0]; $r(m=>1) = ra[1]; $r(m=>2) = ra[2];
  });

# Plain XS on Perl data, through the same qrot_vec as rotq_shared.
# q is always an array ref [x, y, z, w].
pp_add_exported('', 'xs_rot1 xs_rot1_list xs_rot_aoa xs_rot_cols');
pp_add_exported('', 'xs_rot1_into xs_rot_aoa_into xs_rot_cols_into');
pp_addxs(<<'EOXS');
SV *
xs_rot1(q, v)
    SV *q
    SV *v
  CODE:
    double qa[4], va[3], ra[3];
    qb_get(aTHX_ q, qa, 4, "q");
    qb_get(aTHX_ v, va, 3, "v");
    qrot_vec(qa, va, ra);
    RETVAL = qb_vec3(aTHX_ ra);
  OUTPUT:
    RETVAL

void
xs_rot1_list(x, y, z, w, vx, vy, vz)
    double x
    double y
    double z
    double w
    double vx
    double vy
    double vz
  PPCODE:
    double qa[4] = { x, y, z, w }, va[3] = { vx, vy, vz }, ra[3];
    qrot_vec(qa, va, ra);
    EXTEND(SP, 3);
    mPUSHn(ra[0]);
    mPUSHn(ra[1]);
    mPUSHn(ra[2]);

SV *
xs_rot_aoa(q, vs)
    SV *q
    SV *vs
  CODE:
    double qa[4];
    AV *in, *out;
    SSize_t i, n;
    qb_get(aTHX_ q, qa, 4, "q");
    in = qb_av(aTHX_ vs, "vectors");
    n = av_count(in);
    out = newAV();
    if (n) av_extend(out, n - 1);
    for (i = 0; i < n; i++) {
        double va[3], ra[3];
        SV **e = av_fetch(in, i, 0);
        if (!e) croak("vector %ld is undefined", (long)i);
        qb_get(aTHX_ *e, va, 3, "vector");
        qrot_vec(qa, va, ra);
        av_store(out, i, qb_vec3(aTHX_ ra));
    }
    RETVAL = newRV_noinc((SV *)out);
  OUTPUT:
    RETVAL

void
xs_rot_cols(q, cx, cy, cz)
    SV *q
    SV *cx
    SV *cy
    SV *cz
  PPCODE:
    double qa[4];
    AV *ax, *ay, *az, *ox, *oy, *oz;
    SSize_t i, n;
    qb_get(aTHX_ q, qa, 4, "q");
    ax = qb_av(aTHX_ cx, "x");
    ay = qb_av(aTHX_ cy, "y");
    az = qb_av(aTHX_ cz, "z");
    n = av_count(ax);
    if (av_count(ay) != (Size_t)n || av_count(az) != (Size_t)n)
        croak("x, y and z must have the same length");
    ox = newAV(); oy = newAV(); oz = newAV();
    if (n) { av_extend(ox, n - 1); av_extend(oy, n - 1); av_extend(oz, n - 1); }
    for (i = 0; i < n; i++) {
        SV **ex = av_fetch(ax, i, 0), **ey = av_fetch(ay, i, 0), **ez = av_fetch(az, i, 0);
        double va[3], ra[3];
        va[0] = ex ? SvNV(*ex) : 0;
        va[1] = ey ? SvNV(*ey) : 0;
        va[2] = ez ? SvNV(*ez) : 0;
        qrot_vec(qa, va, ra);
        av_store(ox, i, newSVnv(ra[0]));
        av_store(oy, i, newSVnv(ra[1]));
        av_store(oz, i, newSVnv(ra[2]));
    }
    EXTEND(SP, 3);
    mPUSHs(newRV_noinc((SV *)ox));
    mPUSHs(newRV_noinc((SV *)oy));
    mPUSHs(newRV_noinc((SV *)oz));

# The _into variants write into arrays the caller supplies, reusing the
# scalars (and, for xs_rot_aoa_into, the inner [x, y, z] arrays) already
# there; missing ones are created, so the first call into an empty array
# allocates and later calls reuse.  An output may be the input itself
# (in place): each vector is read before it is written.

void
xs_rot1_into(q, v, r)
    SV *q
    SV *v
    SV *r
  CODE:
    double qa[4], va[3], ra[3];
    AV *out;
    qb_get(aTHX_ q, qa, 4, "q");
    qb_get(aTHX_ v, va, 3, "v");
    out = qb_av(aTHX_ r, "r");
    av_extend(out, 2);
    qrot_vec(qa, va, ra);
    qb_set(aTHX_ out, 0, ra[0]);
    qb_set(aTHX_ out, 1, ra[1]);
    qb_set(aTHX_ out, 2, ra[2]);

void
xs_rot_aoa_into(q, vs, rs)
    SV *q
    SV *vs
    SV *rs
  CODE:
    double qa[4];
    AV *in, *out;
    SSize_t i, n;
    qb_get(aTHX_ q, qa, 4, "q");
    in = qb_av(aTHX_ vs, "vectors");
    out = qb_av(aTHX_ rs, "output");
    n = av_count(in);
    if (n) av_extend(out, n - 1);
    for (i = 0; i < n; i++) {
        double va[3], ra[3];
        AV *rv;
        SV **e = av_fetch(in, i, 0);
        if (!e) croak("vector %ld is undefined", (long)i);
        qb_get(aTHX_ *e, va, 3, "vector");
        qrot_vec(qa, va, ra);
        rv = qb_vec3_slot(aTHX_ out, i);
        qb_set(aTHX_ rv, 0, ra[0]);
        qb_set(aTHX_ rv, 1, ra[1]);
        qb_set(aTHX_ rv, 2, ra[2]);
    }

void
xs_rot_cols_into(q, cx, cy, cz, rx, ry, rz)
    SV *q
    SV *cx
    SV *cy
    SV *cz
    SV *rx
    SV *ry
    SV *rz
  CODE:
    double qa[4];
    AV *ax, *ay, *az, *ox, *oy, *oz;
    SSize_t i, n;
    qb_get(aTHX_ q, qa, 4, "q");
    ax = qb_av(aTHX_ cx, "x");
    ay = qb_av(aTHX_ cy, "y");
    az = qb_av(aTHX_ cz, "z");
    ox = qb_av(aTHX_ rx, "output x");
    oy = qb_av(aTHX_ ry, "output y");
    oz = qb_av(aTHX_ rz, "output z");
    n = av_count(ax);
    if (av_count(ay) != (Size_t)n || av_count(az) != (Size_t)n)
        croak("x, y and z must have the same length");
    if (n) { av_extend(ox, n - 1); av_extend(oy, n - 1); av_extend(oz, n - 1); }
    for (i = 0; i < n; i++) {
        SV **ex = av_fetch(ax, i, 0), **ey = av_fetch(ay, i, 0), **ez = av_fetch(az, i, 0);
        double va[3], ra[3];
        va[0] = ex ? SvNV(*ex) : 0;
        va[1] = ey ? SvNV(*ey) : 0;
        va[2] = ez ? SvNV(*ez) : 0;
        qrot_vec(qa, va, ra);
        qb_set(aTHX_ ox, i, ra[0]);
        qb_set(aTHX_ oy, i, ra[1]);
        qb_set(aTHX_ oz, i, ra[2]);
    }
EOXS

# ---------------------------------------------------------------------------
# Prototype of the API's argument dispatch, in XS (see dispatch.pl).
# xsd_rotate_vec( $q, $v, [$out] ) works out the data form of $v (single
# [x,y,z], records, or { x, y, z } columns), the output mode (allocate,
# into $out, in place), checks shapes, and runs the matching loop.  Blessed
# arguments (ndarrays, objects) are handed to the Perl dispatcher,
# QDispatch::rotate_vec.  Prototype limits: $q must be a single [x,y,z,w].
pp_addhdr(<<'EOH');
enum { QB_BAD, QB_OBJECT, QB_SINGLE, QB_RECORDS, QB_COLUMNS };

/* data form of an argument, looking only at the top level and first element */
static inline int
qb_form(pTHX_ SV *sv)
{
    SV *rv;
    if (!SvROK(sv)) return QB_BAD;
    rv = SvRV(sv);
    if (SvOBJECT(rv)) return QB_OBJECT;
    if (SvTYPE(rv) == SVt_PVAV) {
        SV **e;
        if (av_count((AV *)rv) == 0) return QB_RECORDS;      /* empty batch */
        e = av_fetch((AV *)rv, 0, 0);
        return (e && SvROK(*e)) ? QB_RECORDS : QB_SINGLE;
    }
    if (SvTYPE(rv) == SVt_PVHV) return QB_COLUMNS;
    return QB_BAD;
}

/* the array stored under key in a columns hash; created if create is set */
static inline AV *
qb_col(pTHX_ HV *hv, const char *key, I32 klen, int create)
{
    SV **e = hv_fetch(hv, key, klen, create);
    if (!e) croak("columns hash has no '%s' key", key);
    if (SvROK(*e) && SvTYPE(SvRV(*e)) == SVt_PVAV) return (AV *)SvRV(*e);
    if (!create || SvOK(*e)) croak("column '%s' must be an array reference", key);
    {
        AV *av = newAV();
        sv_setsv(*e, sv_2mortal(newRV_noinc((SV *)av)));
        return av;
    }
}
EOH

# The PDL side of ndarray dispatch, in C: what QDispatch::rotate_vec does for
# ndarrays, without going back into Perl.  The XS dispatcher (xsd2_rotate_vec)
# reaches it only through a function pointer published in
# $QBench::PP_ROTATE_VEC at load time, as PDL publishes its Core struct in
# $PDL::SHARE, so a PDL-free XS module could use it the same way.
pp_addhdr(<<'EOH');
pdl_error pdl_run_rotq(pdl *q, pdl *v, pdl *r);     /* generated by PDL::PP (pp-rotq.c) */

typedef SV *(*qb_rotate_vec_fn)(pTHX_ SV *q, SV *v, SV *out);

/* a new mortal SV owning ndarray p, blessed into PDL */
static SV *
qb_pdl_sv(pTHX_ pdl *p)
{
    SV *sv = sv_newmortal();
    PDL->SetSV_PDL(sv, p);
    return sv_isobject(sv) ? sv : sv_bless(sv, gv_stashpvs("PDL", GV_ADD));
}

/* rotate ndarray vectors v by q (an ndarray, or a single [x, y, z, w]);
   out is undef (allocate), or a double or null ndarray (into, or in place) */
static SV *
qb_pp_rotate_vec(pTHX_ SV *q, SV *v, SV *out)
{
    pdl *qp, *vp, *op;
    if (!(SvROK(v) && sv_derived_from(v, "PDL"))) croak("not a recognised data form");
    vp = PDL->SvPDLV(v);
    if (SvROK(q) && sv_derived_from(q, "PDL"))
        qp = PDL->SvPDLV(q);
    else {                                         /* a single quaternion as Perl data */
        PDL_Indx dims[1] = { 4 };
        qp = PDL->pdlnew();
        if (!qp) croak("cannot create an ndarray");
        qb_pdl_sv(aTHX_ qp);                       /* the mortal SV owns qp from here */
        qp->datatype = PDL_D;
        PDL->barf_if_error(PDL->setdims(qp, dims, 1));
        PDL->barf_if_error(PDL->allocdata(qp));
        qb_get(aTHX_ q, (double *)qp->data, 4, "q");
    }
    if (!SvOK(out)) {
        SV *r_sv;
        op = PDL->pdlnew();
        if (!op) croak("cannot create an ndarray");
        r_sv = qb_pdl_sv(aTHX_ op);
        PDL->barf_if_error(pdl_run_rotq(qp, vp, op));
        return SvREFCNT_inc(r_sv);
    }
    if (!(SvROK(out) && sv_derived_from(out, "PDL"))) croak("output must be a double ndarray");
    op = PDL->SvPDLV(out);
    if (!(op->state & PDL_NOMYDIMS) && op->datatype != PDL_D) croak("output must be a double ndarray");
    PDL->barf_if_error(pdl_run_rotq(qp, vp, op));   /* in place when out is v */
    return SvREFCNT_inc(out);
}
EOH
pp_add_boot('sv_setiv(get_sv("QBench::PP_ROTATE_VEC", GV_ADD), PTR2IV(&qb_pp_rotate_vec));' . "\n");

pp_add_exported('', 'xsd_rotate_vec xsd2_rotate_vec');
pp_addxs(<<'EOXS');
SV *
xsd_rotate_vec(q, v, out = &PL_sv_undef)
    SV *q
    SV *v
    SV *out
  ALIAS:
    xsd2_rotate_vec = 1
  CODE:
    double qa[4];
    int fv = qb_form(aTHX_ v), fq = qb_form(aTHX_ q);
    int have_out = SvOK(out);
    if (fv == QB_OBJECT || fq == QB_OBJECT
        || (have_out && SvROK(out) && SvOBJECT(SvRV(out)))) {
      if (ix == 1) {
        /* xsd2: ndarrays go to the PDL side's C function, found through
           the pointer it published; no PDL API is used here */
        static qb_rotate_vec_fn fn = NULL;
        if (!fn) {
            SV *hook = get_sv("QBench::PP_ROTATE_VEC", 0);
            if (!hook || !SvIOK(hook)) croak("ndarrays need the PDL part of the module");
            fn = INT2PTR(qb_rotate_vec_fn, SvIV(hook));
        }
        RETVAL = fn(aTHX_ q, v, out);
      }
      else {
        /* xsd: ndarrays and objects: hand over to the Perl dispatcher */
        dSP;
        int count;
        ENTER; SAVETMPS;
        PUSHMARK(SP);
        XPUSHs(q); XPUSHs(v); if (have_out) XPUSHs(out);
        PUTBACK;
        count = call_pv("QDispatch::rotate_vec", G_SCALAR);
        SPAGAIN;
        if (count != 1) croak("QDispatch::rotate_vec returned %d values", count);
        RETVAL = newSVsv(POPs);
        PUTBACK;
        FREETMPS; LEAVE;
      }
    }
    else {
        if (fq != QB_SINGLE) croak("prototype: q must be a single [x, y, z, w]");
        qb_get(aTHX_ q, qa, 4, "q");
        if (have_out && !(SvROK(out)
                          && SvTYPE(SvRV(out)) == (fv == QB_COLUMNS ? SVt_PVHV : SVt_PVAV)))
            croak("output must be %s, like the vectors",
                  fv == QB_COLUMNS ? "a hash reference" : "an array reference");
        switch (fv) {
        case QB_SINGLE: {
            double va[3], ra[3];
            AV *o;
            qb_get(aTHX_ v, va, 3, "v");
            qrot_vec(qa, va, ra);
            if (!have_out) { RETVAL = qb_vec3(aTHX_ ra); break; }
            o = (AV *)SvRV(out);
            av_extend(o, 2);
            qb_set(aTHX_ o, 0, ra[0]); qb_set(aTHX_ o, 1, ra[1]); qb_set(aTHX_ o, 2, ra[2]);
            av_fill(o, 2);
            RETVAL = SvREFCNT_inc(out);
            break;
        }
        case QB_RECORDS: {
            AV *in = (AV *)SvRV(v), *o;
            SSize_t i, n = av_count(in);
            o = have_out ? (AV *)SvRV(out) : newAV();
            if (n) av_extend(o, n - 1);
            for (i = 0; i < n; i++) {
                double va[3], ra[3];
                SV **e = av_fetch(in, i, 0);
                if (!e) croak("vector %ld is undefined", (long)i);
                qb_get(aTHX_ *e, va, 3, "vector");
                qrot_vec(qa, va, ra);
                if (have_out) {
                    AV *rv = qb_vec3_slot(aTHX_ o, i);
                    qb_set(aTHX_ rv, 0, ra[0]); qb_set(aTHX_ rv, 1, ra[1]); qb_set(aTHX_ rv, 2, ra[2]);
                    av_fill(rv, 2);
                }
                else
                    av_store(o, i, qb_vec3(aTHX_ ra));
            }
            if (have_out) { av_fill(o, n - 1); RETVAL = SvREFCNT_inc(out); }
            else RETVAL = newRV_noinc((SV *)o);
            break;
        }
        case QB_COLUMNS: {
            HV *hin = (HV *)SvRV(v), *hout;
            AV *ax = qb_col(aTHX_ hin, "x", 1, 0), *ay = qb_col(aTHX_ hin, "y", 1, 0),
               *az = qb_col(aTHX_ hin, "z", 1, 0), *ox, *oy, *oz;
            SSize_t i, n = av_count(ax);
            if (av_count(ay) != (Size_t)n || av_count(az) != (Size_t)n)
                croak("x, y and z must have the same length");
            hout = have_out ? (HV *)SvRV(out) : newHV();
            ox = qb_col(aTHX_ hout, "x", 1, 1); oy = qb_col(aTHX_ hout, "y", 1, 1);
            oz = qb_col(aTHX_ hout, "z", 1, 1);
            if (n) { av_extend(ox, n - 1); av_extend(oy, n - 1); av_extend(oz, n - 1); }
            for (i = 0; i < n; i++) {
                SV **ex = av_fetch(ax, i, 0), **ey = av_fetch(ay, i, 0), **ez = av_fetch(az, i, 0);
                double va[3], ra[3];
                va[0] = ex ? SvNV(*ex) : 0; va[1] = ey ? SvNV(*ey) : 0; va[2] = ez ? SvNV(*ez) : 0;
                qrot_vec(qa, va, ra);
                if (have_out) {
                    qb_set(aTHX_ ox, i, ra[0]); qb_set(aTHX_ oy, i, ra[1]); qb_set(aTHX_ oz, i, ra[2]);
                }
                else {
                    av_store(ox, i, newSVnv(ra[0])); av_store(oy, i, newSVnv(ra[1]));
                    av_store(oz, i, newSVnv(ra[2]));
                }
            }
            if (have_out) { av_fill(ox, n - 1); av_fill(oy, n - 1); av_fill(oz, n - 1);
                            RETVAL = SvREFCNT_inc(out); }
            else RETVAL = newRV_noinc((SV *)hout);
            break;
        }
        default:
            croak("v is not a recognised data form");
        }
    }
  OUTPUT:
    RETVAL
EOXS

pp_done();
